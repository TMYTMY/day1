# OpenRouter, or any OpenAI-compatible chat completions API.
# Leave the key blank to use the local SQL planner. The demo still answers
# revenue and DAU questions without a key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# sqlite (default) | postgres | athena
# postgres and athena are adapter stubs. The demo runs on sqlite.
DB_BACKEND=sqlite
DB_PATH=data/demo.db

# Read-only credentials for a future Postgres adapter. Unused by SQLite.
# DATABASE_URL=
# DB_USER=
# DB_PASSWORD=

# Future Athena adapter. Unused by SQLite.
# ATHENA_REGION=
# ATHENA_DATABASE=
# ATHENA_WORKGROUP=
# ATHENA_OUTPUT=

AUDIT_PATH=data/audit.db
MAX_RESULT_ROWS=500

# Wall-clock limit on one statement, in milliseconds. 0 disables it.
SQL_TIMEOUT_MS=5000

# Knowledge base embeddings.
# local (default) hashes tokens on this machine and needs no key.
# openrouter calls the embeddings endpoint on OPENROUTER_BASE_URL.
# EMBEDDING_API_KEY overrides OPENROUTER_API_KEY for that call only.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_API_KEY=
KNOWLEDGE_PATH=data/knowledge

# Declared sources belong to one instance. Give each instance its own directory,
# database and staging directory, or two instances on one machine see the same
# declared tables.
# SOURCES_DIR=config/sources
# SOURCES_DB=data/sources.sqlite
# SOURCES_STAGING_DIR=data/staging

# Alert notifications. Easiest path: `python -m src.mail_setup` writes these for
# you (provider presets, password never echoed) and sends one real test message.
# The worker refuses to run without SMTP_HOST, rather than
# evaluate a fire and deliver nothing. SMTP_FROM defaults to SMTP_USER (when it
# is an address) and then to day1-alerts@localhost; STARTTLS defaults to on.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=true
# SMTP_SSL=false        # implicit TLS (port 465). Setting this turns STARTTLS off.
